{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafetyAlertMessage",
  "description": "Safety monitoring status and alert payload.",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "time_hours": { "type": "number" },
    "limit_radius_m": { "type": "number" },
    "measured_radius_m": { "type": ["number", "null"] },
    "forecast_radius_m": { "type": ["number", "null"] },
    "triggered": { "type": "boolean" },
    "status": { "type": "string" },
    "reason": { "type": "string" },
    "metric": { "type": "string" },
    "r_max_m": { "type": ["number", "null"] },
    "r_min_m": { "type": ["number", "null"] },
    "limit_min_radius_m": { "type": ["number", "null"] },
    "warn_fraction": { "type": ["number", "null"] },
    "critical_fraction": { "type": ["number", "null"] },
    "rmin_below_floor": { "type": ["boolean", "null"] },
    "recommended_action": { "type": ["string", "null"] },

    "predicate_m1": { "type": ["boolean", "null"] },
    "predicate_m2": { "type": ["boolean", "null"] },
    "predicate_f1": { "type": ["boolean", "null"] },
    "predicate_f2": { "type": ["boolean", "null"] },
    "forecast_radius_keep_m": { "type": ["number", "null"] },
    "forecast_radius_stop_m": { "type": ["number", "null"] },
    "time_to_breach_hours": { "type": ["number", "null"] },
    "lookahead_hours": { "type": ["number", "null"] },
    "measurement_age_hours": { "type": ["number", "null"] },
    "forecast_age_hours": { "type": ["number", "null"] },
    "forecast_available": { "type": ["boolean", "null"] },
    "confirm_count": { "type": ["integer", "null"] },
    "confirm_required": { "type": ["integer", "null"] },
    "latched": { "type": ["boolean", "null"] }
  },
  "required": [
    "time_hours",
    "limit_radius_m",
    "measured_radius_m",
    "forecast_radius_m",
    "triggered",
    "status",
    "reason",
    "metric"
  ],
  "additionalProperties": false
}
